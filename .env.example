# Chave da API do Gemini: crie em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelos para sugerir respostas, em ordem de preferência: se um estiver sobrecarregado, usa o próximo
GEMINI_MODEL=gemini-3.5-flash,gemini-3.6-flash,gemini-flash-latest

# Sua voz clonada no VoiceStudio (o app precisa estar aberto). Vazio = voz genérica do Piper.
VOZ_CLONADA=

# Qualidade da voz clonada: 8 = mais rápido, 16 = mais natural
VOZ_PASSOS=8
